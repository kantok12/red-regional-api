# Copiar a .env.local y completar. Las EXPO_PUBLIC_* quedan dentro de la app
# (no son secretos); el resto solo se usa al compilar.

# Backend (backend/server.py)
EXPO_PUBLIC_API_URL=http://localhost:5000

# Firebase: Consola > Configuración del proyecto > Tus apps > App web
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In nativo: client ID "Web" (OAuth) del proyecto de Firebase.
# Lo usa Android/iOS para obtener un idToken que Firebase acepta.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Compilación nativa
GOOGLE_IOS_URL_SCHEME=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
ANDROID_PACKAGE=cl.redregional.app
IOS_BUNDLE_ID=cl.redregional.app
